# P2P Fraud Detective FR — variables d'environnement
# Toutes les variables sont optionnelles : l'application démarre en mode démo
# si aucune n'est fournie. Centralisées via p2p_fraud.config.Settings.

# ─── Sirene API (INSEE) ──────────────────────────────────────────────────────
# Gratuit, 30 req/s. Token : https://api.insee.fr/catalogue/
SIRENE_API_TOKEN=

# ─── Anthropic Claude API (génération narrative ISA 240) ─────────────────────
# Console : https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── FastAPI bearer auth ─────────────────────────────────────────────────────
FRAUD_API_SECRET=
FRAUD_CASES_DB=cases.db

# ─── OIDC (Microsoft Entra ID / Auth0 / Keycloak) ────────────────────────────
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Mapping des groupes OIDC → rôles RBAC (JSON valide)
# {"DG-Audit":"admin","Audit-Senior":"manager","Audit-Junior":"analyst"}
OIDC_ROLE_MAP=
# Clé HMAC pour signer les cookies de session (≥ 32 octets aléatoires)
# Génération : python -c 'import secrets; print(secrets.token_urlsafe(48))'
OIDC_SESSION_SECRET=
# URL de redirection après login OIDC (relative au domaine ou absolue)
OIDC_POST_LOGIN_URL=/
# Durée maximale d'une session signée (secondes), 8h par défaut
OIDC_SESSION_MAX_AGE=28800

# ─── Chiffrement IBAN au repos (Fernet) ──────────────────────────────────────
# Génération : python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
P2P_FRAUD_DATA_KEY=

# ─── Auth applicative ────────────────────────────────────────────────────────
P2P_FRAUD_USERS_PATH=
P2P_FRAUD_AUTH_REQUIRED=0

# ─── Persistance (P4-2) ──────────────────────────────────────────────────────
# Vide → SQLite par défaut. PostgreSQL : postgresql://user:pass@host:5432/p2pfd
DATABASE_URL=

# ─── Alertes monitoring (P3.4) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ─── Observabilité (P4-6) ────────────────────────────────────────────────────
SENTRY_DSN=

# ─── DECP (data.economie.gouv.fr) ────────────────────────────────────────────
DECP_PARQUET_PATH=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ─── Hugging Face datasets synthétiques pour le Workbench Vercel ─────────────
# Optionnel: si vide ou indisponible, l'app Next utilise les scénarios locaux.
HF_SYNTHETIC_SCENARIOS_URL=
HF_SYNTHETIC_CASES_URL=
HF_TOKEN=
