# API Sirene v3 (INSEE) — gratuit, 30 req/s
# Obtenir un token : https://api.insee.fr/catalogue/
SIRENE_API_TOKEN=

# Optionnel : chemin local du fichier DECP (Données Essentielles de la Commande Publique)
# Téléchargement : https://www.data.gouv.fr/fr/datasets/donnees-essentielles-de-la-commande-publique-fichiers-consolides/
DECP_PARQUET_PATH=

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
