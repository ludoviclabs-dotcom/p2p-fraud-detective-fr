{
  "name": "@p2pfd/shared-types",
  "version": "0.5.0",
  "private": true,
  "description": "TypeScript types générés depuis l'OpenAPI FastAPI (regénérer avec pnpm sdk:gen-types).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "regenerate": "openapi-typescript ../../docs/api/openapi.json --output src/api.ts && echo 'export * from \"./api\";' > src/index.ts"
  }
}
