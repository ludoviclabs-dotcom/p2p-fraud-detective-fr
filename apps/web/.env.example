# URL du backend FastAPI (Hugging Face Spaces ou local).
# Côté Vercel, à définir dans Project Settings > Environment Variables.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Bearer token utilisé par les routes /api/auth/* proxy.
# Sur la démo publique, laisser vide → backend en mode "anonymous OK".
FRAUD_API_SECRET=

# Source optionnelle de scénarios synthétiques hébergés sur Hugging Face.
# Si vide ou indisponible, /api/risk/scenarios retombe sur les scénarios locaux.
HF_SYNTHETIC_SCENARIOS_URL=
HF_SYNTHETIC_CASES_URL=
HF_TOKEN=

# ─── IA (ADR-0007) ───────────────────────────────────────────────────────────
# ⚠ AUCUNE variable ANTHROPIC_API_KEY ici, ni maintenant ni plus tard :
# la clé Claude vit exclusivement côté backend Python (.env racine, laissée
# vide tant que l'IA n'est pas activée). Le frontend consomme les features IA
# via /api/v1 — jamais l'API Anthropic en direct. Sans clé backend, les
# endpoints IA répondent 503 et les panneaux affichent leur fallback.
